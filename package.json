{
  "name": "ailexsi-soundstation",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AILEXSI SoundStation — standalone groove workstation and playable electronic instrument.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 43217 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 43217 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "vite": "^8.2.2",
    "vitest": "^3.2.4"
  }
}
